# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and this one is opted in: it holds no secret, only the fact that a
# deployment talks to its own /api rather than the in-browser mock.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded video files (local object storage)
.uploads/
